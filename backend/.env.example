# Copy to .env and fill in real values. Never commit .env.

DJANGO_SETTINGS_MODULE=core.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam

# Supabase Postgres connection string, e.g.:
# postgres://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

REDIS_URL=redis://localhost:6379/0

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_PROFILE_PICTURES=profile-pictures
SUPABASE_BUCKET_ORG_LOGOS=org-logos
SUPABASE_BUCKET_DOCUMENTS=documents

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@swams.app

SMS_API_KEY=
